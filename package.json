{
  "name": "proofpay",
  "private": true,
  "workspaces": [
    "apps/api",
    "apps/web",
    "workflows"
  ],
  "scripts": {
    "dev": "concurrently \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm --workspace apps/api run dev",
    "dev:web": "npm --workspace apps/web run dev",
    "build": "npm run build --workspace apps/api && npm run build --workspace apps/web && npm run build --workspace workflows",
    "db:generate": "npm --workspace apps/api run db:generate",
    "db:migrate": "npm --workspace apps/api run db:migrate",
    "db:seed": "npm --workspace apps/api run db:seed",
    "format": "prettier --write .",
    "paypal:sandbox:check": "node scripts-test-paypal.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "prettier": "^3.6.2",
    "prisma": "^8.0.0-rc.33",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "dotenv": "^18.0.10"
  }
}
