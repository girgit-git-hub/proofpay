generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TaskStatus {
  DRAFT
  FUNDED
  IN_PROGRESS
  SUBMITTED
  VERIFYING
  VERIFIED
  REVIEW
  REJECTED
  PAID
}

enum EvidenceStatus {
  UPLOADED
  VERIFYING
  VERIFIED
  FLAGGED
  REJECTED
}

enum VerificationDecision {
  VERIFIED
  REVIEW
  REJECTED
}

enum PayoutStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  HELD
}

model User {
  id          String     @id @default(cuid())
  name        String
  email       String     @unique
  role        String     @default("WORKER")
  createdAt   DateTime   @default(now())

  tasks       Task[]     @relation("FunderTasks")
  workerTasks Task[]     @relation("WorkerTasks")
  evidence    Evidence[]
}

model Task {
  id              String           @id @default(cuid())
  title           String
  description     String
  amount          Decimal          @db.Decimal(12, 2)
  currency        String           @default("USD")
  requiredProduct String?
  latitude        Float?
  longitude       Float?
  status          TaskStatus       @default(DRAFT)

  funderId        String
  workerId        String?

  paypalOrderId   String?

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  funder          User             @relation("FunderTasks", fields: [funderId], references: [id])
  worker          User?            @relation("WorkerTasks", fields: [workerId], references: [id])

  evidence        Evidence[]
  verification    Verification?
  payout          Payout?
}

model Evidence {
  id             String         @id @default(cuid())
  taskId         String
  workerId       String
  filePath       String
  originalName   String
  mimeType       String
  sha256         String
  perceptualHash String?
  exifJson       Json?
  latitude       Float?
  longitude      Float?
  capturedAt     DateTime?
  status         EvidenceStatus @default(UPLOADED)
  createdAt      DateTime       @default(now())

  task           Task           @relation(fields: [taskId], references: [id], onDelete: Cascade)
  worker         User           @relation(fields: [workerId], references: [id])
}

model Verification {
  id             String               @id @default(cuid())
  taskId         String               @unique
  decision       VerificationDecision
  overallScore   Int
  checks         Json
  explanation    String
  model          String
  createdAt      DateTime             @default(now())

  task           Task                 @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

model Payout {
  id             String       @id @default(cuid())
  taskId         String       @unique
  workerEmail    String
  amount         Decimal      @db.Decimal(12, 2)
  currency       String       @default("USD")
  status         PayoutStatus @default(PENDING)
  paypalBatchId  String?
  idempotencyKey String       @unique
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  task           Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

model WebhookEvent {
  id        String   @id @default(cuid())
  eventId   String   @unique
  eventType String
  payload   Json
  processed Boolean  @default(false)
  createdAt DateTime @default(now())
}